# ==============================================================================
# Beacon AI - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Lead Notification Email
# ------------------------------------------------------------------------------
# Recipient email address for new lead notifications (single or comma-separated)
LEAD_NOTIFICATION_EMAIL=sahad@mccollinsmedia.com

# ------------------------------------------------------------------------------
# 2. HubSpot Integration (Forms API v3)
# ------------------------------------------------------------------------------
HUBSPOT_PORTAL_ID=149302624
HUBSPOT_FORM_ID=8c5b3426-4fde-4fed-be0e-ebe9fe34c651
HUBSPOT_REGION=eu1

# Optional alternative: Private App Token (CRM API v3)
# HUBSPOT_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 3. Email Delivery via Nodemailer SMTP (developer@mccollinsmedia.com)
# ------------------------------------------------------------------------------
# For Google Workspace / Gmail:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=developer@mccollinsmedia.com
SMTP_PASS=your_app_password_here
SMTP_FROM="Beacon AI Leads" <developer@mccollinsmedia.com>

# For Microsoft 365 (alternative):
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=developer@mccollinsmedia.com
# SMTP_PASS=your_app_password_here
# SMTP_FROM="Beacon AI Leads" <developer@mccollinsmedia.com>
