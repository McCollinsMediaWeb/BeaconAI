# ==============================================================================
# Beacon AI - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Lead Notification Email
# ------------------------------------------------------------------------------
# Recipient email address for new lead notifications (Default: meghna@mccollinsmedia.com)
LEAD_NOTIFICATION_EMAIL=meghna@mccollinsmedia.com

# ------------------------------------------------------------------------------
# 2. HubSpot Integration (Choose Option A, B, or C)
# ------------------------------------------------------------------------------
# Option A (Recommended): HubSpot Private App Token (CRM API v3)
# Create a Private App in HubSpot Settings -> Integrations -> Private Apps
# Required Scopes: crm.objects.contacts.write, crm.objects.contacts.read
HUBSPOT_ACCESS_TOKEN=

# Option B: HubSpot Forms API v3 (Submissions API)
# Found in your HubSpot Form URL / Embed code
# HUBSPOT_PORTAL_ID=
# HUBSPOT_FORM_ID=

# Option C: Custom Webhook URL
# HUBSPOT_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 3. Email Delivery (Choose SMTP or Resend)
# ------------------------------------------------------------------------------
# Option A: SMTP (Microsoft 365 / Google Workspace / AWS SES / SendGrid)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Beacon AI Leads" <leads@mccollinsmedia.com>

# Option B: Resend (Alternative API)
# RESEND_API_KEY=
# RESEND_FROM="Beacon AI" <onboarding@resend.dev>
